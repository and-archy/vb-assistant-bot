TELEGRAM_TOKEN=your-token-here
# Мінімум двоє (ТЗ п.4 — щоб не залежати від однієї людини).
ADMIN_USER_IDS=111111111,222222222
# Chat ID групи General, куди бот публікує ранкове повідомлення.
# Бот має бути учасником групи з правом писати (ТЗ п.12).
GROUP_CHAT_ID=-1001234567890

# alerts.in.ua — безкоштовний ключ для розробників (api@alerts.in.ua).
ALERTS_API_TOKEN=your-alerts-in-ua-token
# uid м. Києва в alerts.in.ua (перевірте на /v1/regions.json власним ключем —
# на момент написання це "31", але API може змінити нумерацію).
ALERTS_REGION_UID=31

DB_PATH=vb_assistant.db
TIMEZONE=Europe/Kyiv

TEXTS_CONFIG_PATH=config/texts.json
THRESHOLDS_CONFIG_PATH=config/thresholds.json

# ТЗ п.13: перший місяць — лише ручний режим, бот НІКОЛИ не публікує сам
# о 08:00, лише нагадує адмінам. Вмикайте свідомо, коли довіра до
# алгоритму підтверджена.
AUTO_PUBLISH_ENABLED=false

# Опційно: шлях до файлу логів з ротацією (5MB x3). Порожньо -> лише stdout.
LOG_FILE=
